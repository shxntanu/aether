# Local PostgreSQL profile. Replace this URL with a hosted Postgres/Supabase URL in deployment.
AETHER_DATABASE_URL=postgres://aether:aether@127.0.0.1:5432/aether?sslmode=disable
AETHER_STORAGE_PROVIDER=local
AETHER_LOCAL_STORAGE_PATH=./data/vault
AETHER_HTTP_ADDRESS=:8080
AETHER_SHUTDOWN_TIMEOUT=10s
AETHER_PUBLIC_URL=http://localhost:8080
AETHER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
AETHER_REQUEST_TIMEOUT=30s
AETHER_UPLOAD_TIMEOUT=10m
# Optional edge-to-backend credential. Leave empty for unrestricted local
# development; production values must contain at least 32 random bytes.
AETHER_GATEWAY_SECRET=

# Google OIDC login. The redirect URI must match the Google OAuth client
# registration exactly. Set AETHER_PUBLIC_URL to your browser-facing HTTPS
# origin in production; localhost HTTP remains valid during development.
AETHER_GOOGLE_CLIENT_ID=
AETHER_GOOGLE_CLIENT_SECRET=
AETHER_GOOGLE_REDIRECT_URL=
AETHER_BOOTSTRAP_ADMIN_EMAIL=
AETHER_SECURE_COOKIES=false

# Google Drive vault-owner OAuth. Required when AETHER_STORAGE_PROVIDER=gdrive.
# Keep the refresh token in deployment secret storage; never commit it.
AETHER_GDRIVE_CLIENT_ID=
AETHER_GDRIVE_CLIENT_SECRET=
AETHER_GDRIVE_REDIRECT_URL=https://vault.example/auth/gdrive/callback
AETHER_GDRIVE_FOLDER_ID=
AETHER_GDRIVE_REFRESH_TOKEN=

# Must point to a disposable database used only by repository contract tests.
AETHER_TEST_POSTGRES_URL=postgres://aether:aether@127.0.0.1:5432/aether_test?sslmode=disable
